# Copy to .env and fill in. Nothing here is a secret: these are public identifiers.
# The only credential involved is the delegated token MSAL caches in .token_cache.json.

# Your app registration (public client, no client secret).
# See README "App registration" for the four settings it needs.
PA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The tenant you are demoing against.
# Use a DEMO tenant, not a client or production tenant - this server creates,
# edits and runs real flows.
PA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to Default-<PA_TENANT_ID>, the tenant's default environment.
# Override to target a sandbox environment instead.
# PA_ENV_ID=Default-00000000-0000-0000-0000-000000000000
