# Direct dependencies, loosely specified. This is the file you edit.
#
# requirements.txt is the compiled lockfile generated from this one - every
# package pinned to an exact version, transitives included. Do not edit it by hand.
#
# Regenerate after changing anything here:
#
#   uv pip compile requirements.in --universal --python-version 3.10 -o requirements.txt
#
# --universal resolves for every OS at once and emits environment markers, so the
# same lockfile works on Windows, macOS and Linux. --python-version 3.10 matches
# the minimum this server supports.

# mcp 2.x. server.py imports MCPServer from mcp.server.mcpserver, the 2.x name for
# FastMCP, so a 1.x install fails at import. 2.3 is the floor it was tested on; the
# <3 cap is there because the next major will break something, as 2.0 did.
# There is no `server` extra on modern mcp releases; requesting mcp[server] is a
# silent no-op.
mcp>=2.3.0,<3

# Declared because it is imported, and since mcp 2.x it is no longer a free
# transitive: the SDK switched to httpx2 and stopped installing httpx. The two
# coexist; only objects handed to the SDK itself would need to be httpx2, and this
# server hands it none.
httpx>=0.27.0
python-dotenv>=1.0.0

# server.py imports TypedDict from here, not from typing: pydantic rejects
# typing.TypedDict below Python 3.12 and raises PydanticUserError at import time,
# which takes the whole server down. It already arrives as a pydantic transitive,
# but we import it directly, so it is declared rather than assumed. 4.13 is the
# floor mcp 2.x itself requires.
typing-extensions>=4.13.0
